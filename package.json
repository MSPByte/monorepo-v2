{
  "name": "mspbyte",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:agent": "turbo run dev --filter=agent --filter=agents",
    "dev:web": "turbo run dev --filter=frontend --filter=api --filter=@mspbyte/trpc --filter=@mspbyte/shared",
    "dev:api": "turbo run dev --filter=api",
    "dev:pipeline": "turbo run dev --filter=pipeline --filter=ingestion --filter=alerts --filter=compliance",
    "build": "turbo run build",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e --filter=frontend",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:clean": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "turbo run db:generate --filter=@mspbyte/drizzle",
    "db:migrate": "turbo run db:migrate --filter=@mspbyte/drizzle",
    "db:push": "turbo run db:push --filter=@mspbyte/drizzle",
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@playwright/test": "1.52.0",
    "playwright": "1.52.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
