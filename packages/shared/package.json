{
  "name": "@mspbyte/shared",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./src/*/index.ts",
      "default": "./src/*.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsc --watch -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mspbyte/drizzle": "*",
    "drizzle-orm": "^1.0.0-beta.22",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
